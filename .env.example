# Copy to .env.local or export these values. Never commit real handles or paths.
PAUL_IMESSAGE_HANDLE="<exact-e164-or-apple-id-email>"
IMESSAGE_EXTRA_ALLOW_FROM=""
IMSG_CLI_PATH="/absolute/path/to/imsg"
IMESSAGE_DB_PATH="/absolute/path/to/Library/Messages/chat.db"
OPENCLAW_CONFIG_PATH="/absolute/path/to/openclaw.json"

# Live smoke target must be an exact E.164 number or email and appear verbatim
# in the comma-separated allowlist.
IMESSAGE_TEST_RECIPIENT="<exact-e164-or-email>"
IMESSAGE_TEST_ALLOWLIST="<same-exact-e164-or-email>"

# DANGER: uncomment only immediately before intentionally sending one fixed test.
# IMESSAGE_TEST_CONFIRM="SEND_ONE_TEST_MESSAGE"

# Guarded agent-to-iMessage E2E uses separate target, allowlist, and confirmation.
OPENCLAW_CLI_PATH="/absolute/path/to/openclaw"
# Example only: choose a configured model already tested with `openclaw agent`.
OPENCLAW_E2E_MODEL="openrouter/auto"
IMESSAGE_E2E_RECIPIENT="<exact-e164-or-email>"
IMESSAGE_E2E_ALLOWLIST="<same-exact-e164-or-email>"

# DANGER: distinct confirmation for one agent-generated E2E test message.
# IMESSAGE_E2E_CONFIRM="SEND_ONE_AGENT_E2E_MESSAGE"
